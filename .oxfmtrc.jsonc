{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "all",
	"printWidth": 100,
	"svelte": true,
	"sortPackageJson": false,
	"ignorePatterns": [
		".DS_Store",
		"node_modules",
		"/build",
		"/.svelte-kit",
		"/package",
		"/dist",
		".env",
		".env.*",
		"!.env.example",
		"/src/lib/expression/parse/expression_parser.js",
		"/src/lib/expression/parse/expression_parser.terms.js",
		"pnpm-lock.yaml",
		"package-lock.json",
		"bun.lock",
		"/static",
		"/src/lib/generated_static_assets.ts",
		"/packages/snapshot_item_lookup_api/snapshot_data",
		"/packages/*/compose.json",
	],
}
